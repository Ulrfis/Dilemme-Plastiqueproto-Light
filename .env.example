# Runtime
NODE_ENV=production
PORT=5000

# PostgreSQL
# Replit during export, then the internal PostgreSQL URL supplied by Coolify.
DATABASE_URL=postgresql://user:password@host:5432/database
DB_POOL_MAX=30

# OpenAI
OPENAI_API_KEY=
# Modèle utilisé par Peter (Responses API). Défaut : gpt-5.6-terra.
# gpt-5.6-luna est plus rapide et moins cher, gpt-5.6-sol plus capable.
OPENAI_MODEL=
OPENAI_MAX_CONCURRENT_STREAMS=10
OPENAI_MAX_QUEUED_STREAMS=30
OPENAI_QUEUE_WAIT_TIMEOUT_MS=15000
OPENAI_RUN_TIMEOUT_MS=45000

# Gradium text-to-speech
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=
GRADIUM_MAX_CONCURRENT=5
GRADIUM_MAX_QUEUED=100

# Speech-to-text
DEEPGRAM_API_KEY=

# Administration and observability
ADMIN_TOKEN=
POSTHOG_API_KEY=

# Optional Google Apps Script endpoint
GOOGLE_SCRIPT_URL=
