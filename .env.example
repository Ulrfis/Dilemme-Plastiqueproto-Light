# Runtime
NODE_ENV=production
PORT=5000

# PostgreSQL
# Replit during export, then the internal PostgreSQL URL supplied by Coolify.
DATABASE_URL=postgresql://user:password@host:5432/database
DB_POOL_MAX=30

# OpenAI
OPENAI_API_KEY=
# Modèle utilisé par Peter (Responses API). Défaut : gpt-5.6-luna (le plus
# rapide). gpt-5.6-terra est plus capable, gpt-5.6-sol davantage encore.
OPENAI_MODEL=
# Effort de raisonnement. Défaut : none (aucune réflexion avant de répondre,
# latence minimale). ATTENTION : si ce champ n'est pas envoyé, GPT-5.6 applique
# medium et Peter réfléchit avant chaque réplique.
# Valeurs : none, minimal, low, medium, high, xhigh, max.
OPENAI_REASONING_EFFORT=
# Plafond de tokens de sortie de Peter. Défaut 400 (~1 400 caractères), très
# au-dessus des « une ou deux phrases courtes » demandées par le prompt : c'est
# un garde-fou contre une réponse qui s'emballe et rend un tour anormalement
# lent, pas un réglage de style.
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_MAX_CONCURRENT_STREAMS=10
OPENAI_MAX_QUEUED_STREAMS=30
OPENAI_QUEUE_WAIT_TIMEOUT_MS=15000
OPENAI_RUN_TIMEOUT_MS=45000

# Gradium text-to-speech
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=
GRADIUM_MAX_CONCURRENT=5
GRADIUM_MAX_QUEUED=100
# Région utilisée par les scripts de mesure (npm run probe:gradium / bench:voice).
# eu ou us — eu pour une classe genevoise : moins de latence réseau, données en
# Europe. Le serveur tape encore l'URL REST non régionale ; c'est un des points
# que le banc de mesure sert à trancher.
GRADIUM_REGION=eu

# Vitesse de diction de Peter. Négatif = plus rapide (−4.0 à −0.1), positif =
# plus lent (0.1 à 4.0). Vide = réglage par défaut de Gradium. C'est un choix
# d'oreille qui change le caractère de la voix — à poser après écoute, pas pour
# gagner de la latence.
GRADIUM_PADDING_BONUS=

# Découpage du texte de Peter en blocs audio. Chaque bloc est un appel Gradium
# séparé, donc une prosodie propre et un blanc à la jointure : moins il y a de
# blocs, plus le débit est régulier — mais plus le premier son tarde.
# Les deux premiers règlent le bloc 1 (réactivité), les deux derniers décident
# quand la suite part en cours de stream plutôt qu'à la fin (régularité).
# Défauts : 55 / 2 / 220 / 4 — une réponse normale tient en un ou deux blocs.
TTS_PHASE1_MIN_CHARS=
TTS_PHASE1_MAX_SENTENCES=
TTS_PHASE2_EARLY_CHARS=
TTS_PHASE2_EARLY_SENTENCES=

# Speech-to-text
DEEPGRAM_API_KEY=

# Administration and observability
ADMIN_TOKEN=
POSTHOG_API_KEY=

# Optional Google Apps Script endpoint
GOOGLE_SCRIPT_URL=
